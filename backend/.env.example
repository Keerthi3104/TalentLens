# TalentLens — Backend Environment Variables
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# ── LinkedIn OAuth 2.0 (FREE) ─────────────────────────────────────
# Get these from: https://www.linkedin.com/developers/apps/new
# Step 1: Create app at the URL above
# Step 2: Under "Auth" tab → copy Client ID and Client Secret
# Step 3: Under "Auth" tab → add Redirect URL: http://localhost:8000/api/linkedin/callback
# Step 4: Under "Products" → request "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
FRONTEND_URL=http://localhost:3000

# ── Anthropic API (optional — for AI scoring) ────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
